ANTHROPIC_API_KEY=여기에_본인_API_키

# 2단계부터 필요 — onemove-crm-agent/.env 또는 onemove-daily-report/.env에 있는 값을 그대로 복사
RESERVATION_API_USERNAME=
RESERVATION_API_PASSWORD=
RESERVATION_FRANCHISE_ID=1

# 슬랙 요약 전송용 — Incoming Webhook URL (naver-rank-tracker와 동일 방식)
SLACK_WEBHOOK_URL=

# 구글 시트 기록용 — README의 "구글 시트 설정" 가이드 참고
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=이탈위험목록
